class ParkingSystem {
    // Array to hold slot counts where index 0=big, 1=medium, 2=small
    private int[] slots;

    public ParkingSystem(int big, int medium, int small) {
        this.slots = new int[]{big, medium, small};
    }
    
    public boolean addCar(int carType) {
        // carType - 1 aligns the 1-based input (1, 2, 3) to 0-based array indexing (0, 1, 2)
        if (this.slots[carType - 1] > 0) {
            this.slots[carType - 1]--;
            return true;
        }
        return false;
    }
}
